<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<oddjob id="oddjob">
    <job>
        <sequential>
            <jobs>
                <bean class="dido.elsewhere.ema.TickingTableService" id="tickerTable"/>
                <lseg:ema-iprovider
                        fieldDictionaryPath="${oddjob.dir}/../dictionary/RDMTinyDictionary"
                        enumTypeDictionaryPath="${oddjob.dir}/../dictionary/enumtype.def"
                        configPath="${oddjob.dir}/../config/EmaConfigIProvider.xml"
                        xmlns:lseg="oddjob:lseg">
                    <table>
                        <value value="${tickerTable.table}"/>
                    </table>
                </lseg:ema-iprovider>
            </jobs>
        </sequential>
    </job>
</oddjob>
