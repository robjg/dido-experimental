<arooa:descriptor xmlns:arooa="http://rgordon.co.uk/oddjob/arooa"
                  prefix="lseg" namespace="oddjob:lseg">
    <conversions>
        <arooa:conversion className="dido.elsewhere.ema.IndexConsumerConfigSupplier" methodName="get" arooaValue="true"/>
        <arooa:conversion className="dido.elsewhere.ema.IndexProviderConfigSupplier" methodName="get" arooaValue="true"/>
    </conversions>
    <components>
        <arooa:bean-def element='ema-consumer'
                        className='dido.elsewhere.ema.EmaConsumerService'>
            <properties>
                <arooa:property name="configPath" type="ATTRIBUTE"/>
                <arooa:property name="dictionaryDir" type="ATTRIBUTE"/>
            </properties>
            <annotations>
                <arooa:annotation name="org.oddjob.framework.adapt.Start" method="start"/>
                <arooa:annotation name="org.oddjob.framework.adapt.Stop" method="stop"/>
            </annotations>
        </arooa:bean-def>
        <arooa:bean-def element='ema-client'
                        className='dido.elsewhere.ema.MarketPriceClientService'>
            <annotations>
                <arooa:annotation name="org.oddjob.framework.adapt.Start" method="start"/>
                <arooa:annotation name="org.oddjob.framework.adapt.Stop" method="stop"/>
            </annotations>
        </arooa:bean-def>
        <arooa:bean-def element="ema-iprovider"
                        className="dido.elsewhere.ema.EmaIProviderService">
            <properties>
                <arooa:property name="configPath" type="ATTRIBUTE"/>
                <arooa:property name="fieldDictionaryPath" type="ATTRIBUTE"/>
                <arooa:property name="enumTypeDictionaryPath" type="ATTRIBUTE"/>
            </properties>
        </arooa:bean-def>
    </components>
</arooa:descriptor>